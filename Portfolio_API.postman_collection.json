{
  "info": {
    "name": "COMP229 Assignment 2 - Portfolio API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run '1 - Auth' first: Sign up, then Sign in (the token is saved automatically and used by the protected requests)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "contactId",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "qualificationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 - Welcome",
      "item": [
        {
          "name": "GET welcome message",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "1 - Auth",
      "item": [
        {
          "name": "POST sign up (add new user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mark Perez\",\n  \"email\": \"mark@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "POST sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signin"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mark@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token); pm.collectionVariables.set('userId', j.user._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET sign out",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/signout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signout"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "GET protected route WITHOUT token (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
